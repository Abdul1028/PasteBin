generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Paste {
  id        String   @id @default(cuid())
  content   String
  language  String   @default("plaintext")
  title     String?
  authorName String  @default("Anonymous")
  createdAt DateTime @default(now())
} 